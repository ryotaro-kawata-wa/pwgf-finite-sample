/-! M13r boundary diagnostics; execution and input hashes are recorded beside the canonical receipt. -/
open Matrix MeasureTheory ProbabilityTheory Set
open scoped BigOperators NNReal ProbabilityTheory MatrixOrder Matrix.Norms.Frobenius Topology
namespace PaperFormalization.Manuscript

-- 1. The first auxiliary is read in chronological order.
example : sourceAuxiliaryArray 1 ((ULift.up 7 : SourceAuxiliarySpace Nat Nat 0), 23) (Fin.last 0) = 23 := sourceAuxiliaryArray_last 0 _

-- 2. Reading the strict prefix does not reveal the new auxiliary.
example : sourceAuxiliaryArray 2 (((ULift.up 7 : SourceAuxiliarySpace Nat Nat 0), 23), 41)
    (0 : Fin 2) = 23 := by simp [sourceAuxiliaryArray, Fin.snoc]

-- 3. The last slot of a two-step extension is the new coordinate.
example : sourceAuxiliaryArray 2 (((ULift.up 7 : SourceAuxiliarySpace Nat Nat 0), 23), 41)
    (Fin.last 1) = 41 := sourceAuxiliaryArray_last 1 _

-- 4. Histories change no auxiliary values.
example (h : Nat -> Nat) (z : SourceAuxiliarySpace Nat Nat 2) :
    sourceAuxiliaryArray 2 (sourceAuxiliaryHistory h 2 z) = sourceAuxiliaryArray 2 z := by simp

-- 5. Zero-length finite prefixes have no selected coordinate.
example (h : Fin 3 -> Nat) : ∑ i : Fin 0, sourceFinitePrefix h 0 (by omega) i = 0 := by simp

-- 6. The old prefix of a two-step finite history is its one-step prefix.
example (h : Fin 2 -> Nat) : sourceHistoryInit (sourceFinitePrefix h 2 le_rfl) =
    sourceFinitePrefix h 1 (by omega) := sourceFinitePrefix_init h 1 le_rfl

-- 7. Out-of-schedule values are only explicit totalizations.
example {N d : Nat} (post : SourcePostMap Unit N d) (flowX flowY)
    (h : Fin 0 -> Unit × SourceStepNormal N d) (u : SourceFiniteConfiguration N d) (t : Real) :
    sourceFiniteHorizonBranch post flowX flowY 0 h u 3 t = (u,u) := by
  simp [sourceFiniteHorizonBranch]

-- 8. Identity branch maps reproduce the constructed post-state at the start.
example {N d : Nat} (post : SourcePostMap Unit N d)
    (h : Fin 0 -> Unit × SourceStepNormal N d) (u : SourceFiniteConfiguration N d) :
    sourceCoupledBranch post (fun _ _ x => x) (fun _ _ _ x => x) 0 h u 0 = post 0 h u := by
  exact sourceCoupledBranch_start post _ _ (fun _ => 0) (by intros; rfl) (by intros; rfl) 0 h u

-- 9. A final branch beginning at the last jump has the right post value.
example {N d : Nat} (h : Fin 1 -> Unit × SourceStepNormal N d) (u : SourceFiniteConfiguration N d) :
    sourceFiniteHorizonPath (fun _ _ x => (x,x)) (fun _ _ x => x) (fun _ _ _ x => x)
      (fun n => (n : Real)) 1 h u 1 = (u,u) := by
  simpa using sourceFiniteHorizonPath_at_jump (fun _ _ x => (x,x)) _ _ (fun n => (n : Real)) 1
    (by intro k hk; exact_mod_cast Nat.lt_succ_self k) (by intros; rfl) (by intros; rfl) h u 1 le_rfl

-- 10. A particle-block permutation leaves each spatial coordinate label intact.
example (s : Equiv.Perm (Fin 2)) (i : Fin 2) (j : Fin 3) :
    sourceParticleIndexPermute s (i,j) = (s i,j) := rfl

-- 11. Empirical moment normalization is unchanged by a nontrivial block permutation.
example (X : PiLp 2 (fun _ : Fin 2 => EuclideanSpace Real (Fin 1))) :
    empiricalMomentMap (fun x => x) (sourceParticlePermute (Equiv.swap 0 1) X) =
      empiricalMomentMap (fun x => x) X := source_empiricalMomentMap_permute _ _ _

-- 12. The PSD totalization includes the zero covariance.
example : sourcePsdClip (0 : Matrix (Fin 2) (Fin 2) Real) = 0 :=
  sourcePsdClip_eq _ PosSemidef.zero

-- 13. The fixed whitening permutation law includes singular diagonal covariance.
example (v a : EuclideanSpace Real (Fin 2)) :
    sourceCanonicalWhiteningSeed (sourceMatrixPermute (Equiv.swap 0 1) (1 : Matrix (Fin 2) (Fin 2) Real))
      (isHermitian_one.submatrix (Equiv.swap 0 1))
      (sourceMatrixPermute (Equiv.swap 0 1) (Matrix.diagonal ![1,0]))
      (sourceEuclideanPermute (Equiv.swap 0 1) v) (sourceEuclideanPermute (Equiv.swap 0 1) a) =
      sourceEuclideanPermute (Equiv.swap 0 1)
        (sourceCanonicalWhiteningSeed 1 isHermitian_one (Matrix.diagonal ![1,0]) v a) :=
  sourceCanonicalWhiteningSeed_permute _ _ _ _ _

-- 14. The empty-index whitening coordinate is the unique zero vector.
example (v a : EuclideanSpace Real (Fin 0)) :
    sourceCanonicalWhiteningSeed (0 : Matrix (Fin 0) (Fin 0) Real) isHermitian_zero 0 v a = 0 := by
  ext i
  exact Fin.elim0 i

-- 15. Coordinate-to-vector ODE assembly also permits an empty particle index.
example (X : Real -> SourceFiniteConfiguration 0 3) (t : Real) : HasDerivAt X 0 t := by
  apply source_configuration_hasDerivAt
  intro i
  exact Fin.elim0 i

-- 16. The literal radius loss is zero for an empty cloud (not a tracking assumption).
example (J : Nat) (T alpha K D : Real) (B : NNReal) :
    sourceOriginalRadiusLoss J 0 T alpha K D B = 0 := by simp [sourceOriginalRadiusLoss]

-- 17. The covariance/jump budget is zero when no jumps occur.
example (p : Real) : p/8+p/8+p/8+((0 : Real)/(0+1))*(5*p/32) = 3*p/8 := by ring

-- 18. Path restrictions do not become an unproved conditioning event.
example {O : Type*} (G : Set O) (R C : O -> Prop)
    (h : forall o, o ∈ G -> R o -> C o) : {o | R o ∧ ¬ C o} ⊆ Gᶜ :=
  source_restricted_failure_subset G R C h
end PaperFormalization.Manuscript
